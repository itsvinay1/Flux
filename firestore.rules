rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Data (private per user) ──────────────────────────────────────────
    // Each user can only read/write their own document and all sub-collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Real-time Leaderboard ─────────────────────────────────────────────────
    // Any authenticated user can READ leaderboard (for rankings display)
    // Only the document OWNER (uid == docId) can WRITE their own entry
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Deny All Unmatched ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
