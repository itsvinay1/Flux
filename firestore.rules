rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 Strict Authentication & User Isolation Rules
    // Only authenticated Firebase Auth users can read/write their own document data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Scoped access for sub-collections (challenges, focus, journal, profile, gamification, courses, todos)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🌐 Tribe Leaderboard (Read for all authenticated users; owner-write only)
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == entryId || 
        (resource != null && resource.data.userId == request.auth.uid) || 
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // 🚫 Strict Security Default: Deny All Unmatched Access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
