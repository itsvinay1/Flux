rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 User Isolation Security Rules
    // Only authenticated users can read/write their own document data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Nested user collections (challenges, focus, journal, profile, gamification)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🌐 Public Tribe Leaderboard (Read-only for authenticated users, system-write only)
    match /leaderboard/{entry} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // 🚫 Default Deny All Other Unauthenticated Access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
