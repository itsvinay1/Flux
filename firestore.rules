rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Data (private per user) ──────────────────────────────────────────
    // Each authenticated user can only read/write their own document tree.
    // The sync path is users/{uid}/{collection}/{docId} — subcollection wildcard covers all.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Real-time Leaderboard ─────────────────────────────────────────────────
    // Writes are disabled client-side — scores must be computed server-side via
    // Cloud Functions to prevent cheating (client-written points/XP exploit).
    // READ is restricted to the user's own entry until friend/group scope is implemented.
    match /leaderboard/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Server-only via Cloud Functions
    }

    // ── Deny All Unmatched ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
