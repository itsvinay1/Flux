rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 User Data Collection Security Rules
    // Allow users to read and write their own document collections safely
    match /users/{userId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // 🌐 Tribe Leaderboard Collection
    match /leaderboard/{entry} {
      allow read, write: if true;
    }

    // 🛡️ Default Safe Access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
