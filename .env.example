# FLUX Environment Variables Configuration
# Copy this file to .env or .env.local and add your real keys when ready.

# 1. Google Gemini AI Key (Optional - App uses trained offline intelligence if blank)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Firebase Configuration (Optional - App uses local offline IndexedDB persistence if blank)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=flux-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flux-app
VITE_FIREBASE_STORAGE_BUCKET=flux-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
